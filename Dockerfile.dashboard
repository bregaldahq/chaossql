# syntax=docker/dockerfile:1

# Stage 1: Build React/Vite Frontend
FROM node:20-alpine AS builder

WORKDIR /app

COPY site/package*.json ./
RUN npm ci

COPY site/ ./
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:1.27-alpine-slim

# Copy custom reverse-proxy & SPA config
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/docker/nginx-main.conf /etc/nginx/nginx.conf

# Copy compiled static assets
COPY --from=builder /app/index.html /usr/share/nginx/html/index.html
COPY --from=builder /app/assets/ /usr/share/nginx/html/assets/
COPY --from=builder /app/brand/ /usr/share/nginx/html/brand/
COPY --from=builder /app/public/wasm/ /usr/share/nginx/html/wasm/

USER 101:101
EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=3s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:8080/ || exit 1

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
