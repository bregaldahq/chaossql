# ==============================================================================
# ChaosSQL Enterprise Self-Hosted Environment Configuration
# ==============================================================================

# ChaosSQL Control Plane Server Configuration
PORT=8080
DB_PATH=/data/chaossql-cloud.db
CHAOSSQL_ADMIN_TOKEN=chaossql_prod_secret_token_change_me
PUBLIC_URL=http://localhost:8080

# Web Dashboard Port
DASHBOARD_PORT=3000

# Concurrency Target Database (PostgreSQL 16)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test

# Real-time Alerting Webhooks (Optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.example.com/services/...
