# ==============================================================================
# ChaosSQL Enterprise Self-Hosted Environment Configuration
# ==============================================================================

# ChaosSQL Control Plane Server Configuration
PORT=8080
DB_PATH=/data/chaossql-cloud.db
# Generate an independent secret, for example: openssl rand -hex 32
CHAOSSQL_ADMIN_TOKEN=
PUBLIC_URL=http://localhost:3000

# Web Dashboard Port
DASHBOARD_PORT=3000

# Concurrency Target Database (PostgreSQL 16)
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=test

# Real-time Alerting Webhooks (Optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.example.com/services/...
