{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs 4173",
      "startServerReadyPattern": "listening",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/pt",
        "http://127.0.0.1:4173/pricing",
        "http://127.0.0.1:4173/scenarios/lost-update"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
